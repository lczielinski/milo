(FPCore (x y z t a)
  :name "Graphics.Rendering.Chart.Axis.Types:invLinMap from Chart-1.5.3"
  :milo-source "herbie:haskell.fpcore:121"
  :milo-domain "default"
  :precision binary64
  :pre (and (<= 1 x 2) (<= 4 y 8) (<= 16 z 32) (<= 64 t 128) (<= 256 a 512))
  (+ x (/ (* (- y z) (- t x)) (- a z))))
