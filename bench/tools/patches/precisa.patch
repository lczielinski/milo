+-- The exact value of a decimal literal; reading it as a Double would round it first.
+decNum2Rational :: String -> Data.Ratio.Rational
+decNum2Rational ('-':s) = negate (decNum2Rational s)
+decNum2Rational ('+':s) = decNum2Rational s
+decNum2Rational s = case readFloat s of
+  [(n, "")] -> n
+  _         -> error $ "[decNum2Rational] Cannot parse decimal: " ++ s
