(FPCore (x1 x2 x3 x4 x5 x6)
  :name "floudas1"
  :milo-source "fpbench:fptaylor-real2float.fpcore:3"
  :milo-domain "pre"
  :precision binary64
  :pre (and (<= 0 x1 6) (<= 0 x2 6) (<= 1 x3 5) (<= 0 x4 6) (<= 0 x5 6) (<= 0 x6 10))
  (- (- (- (- (- (* -25 (* (- x1 2) (- x1 2))) (* (- x2 2) (- x2 2))) (* (- x3 1) (- x3 1))) (* (- x4 4) (- x4 4))) (* (- x5 1) (- x5 1))) (* (- x6 4) (- x6 4))))
