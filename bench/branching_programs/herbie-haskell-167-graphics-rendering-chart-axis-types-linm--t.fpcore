(FPCore (x y z t a)
  :name "Graphics.Rendering.Chart.Axis.Types:linMap from Chart-1.5.3"
  :milo-source "herbie:haskell.fpcore:167"
  :milo-domain "widened"
  :milo-widened "t"
  :precision binary64
  :pre (and (<= 1 x 2) (<= 4 y 8) (<= 16 z 32) (<= -128 t 128) (<= 256 a 512))
  (+ x (/ (* (- y x) (- z t)) (- a t))))
