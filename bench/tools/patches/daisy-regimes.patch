@@ -39,6 +39,12 @@ trait Taylor extends DeltaAbstractionUtils with RangeEvaluators {
         }
       }
     }
+    // Comparator gained default max/min on newer JDKs, which collide with
+    // Ordering's; Scala needs an explicit override to disambiguate.
+    override def max[U <: Option[Rational]](x: U, y: U): U =
+      if (compare(x, y) >= 0) x else y
+    override def min[U <: Option[Rational]](x: U, y: U): U =
+      if (compare(x, y) <= 0) x else y
