(FPCore (x y z t a b)
  :name "Diagrams.Solve.Tridiagonal:solveCyclicTriDiagonal from diagrams-solve-0.1, B"
  :milo-source "herbie:haskell.fpcore:41"
  :milo-domain "widened"
  :milo-widened "x"
  :precision binary64
  :pre (and (<= -2 x 2) (<= 4 y 8) (<= 16 z 32) (<= 64 t 128) (<= 256 a 512) (<= 1024 b 2048))
  (/ (+ x (/ (* y z) t)) (+ (+ a 1) (/ (* y b) t))))
